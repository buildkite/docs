<!DOCTYPE html>
<html lang='en'>
  <head>
    <%= render "head" %>
  </head>
  <body data-keywords="docs">
    <%= render "site_header" %>
    <main id="main" role="main">
      <div class="HomePage__container">
        <%= yield %>
        <%= render "footer", hide_feedback: true %>
      </div>
    </main>

    <%# Plain mounts its chat widget as a plain child of <body>, which Turbo
        would otherwise destroy on every navigation. plainChat.js moves it
        into this permanent container the moment it appears, so it survives
        page changes instead of being rebuilt (and briefly breaking) each time. %>
    <div id="plain-chat-turbo-wrapper" data-turbo-permanent></div>
  </body>
</html>
